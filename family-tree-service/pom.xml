<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mouhin.family</groupId>
        <artifactId>family-tree</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>family-tree-service</artifactId>
    <name>Family Tree Service</name>
    <description>业务层：族谱节点、关系、树形结构、用户服务</description>

    <dependencies>
        <dependency>
            <groupId>com.mouhin.family</groupId>
            <artifactId>family-tree-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 仅引入加密工具（BCrypt 密码哈希），不引入完整 Spring Security，避免触发其自动配置 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- 本地缓存：族谱树读缓存 + 登录失败计数，版本由 Spring Boot BOM 管理 -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
