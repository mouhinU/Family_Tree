# ==========================================
# 阿里云 ECS 部署环境变量（对应 deploy/ecs/docker-compose.yml）
#
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交。
# 也可以直接跑 ./ecs-setup.sh env —— 它会生成随机口令写入 .env（0600），不打印到日志。
# ==========================================

# 应用镜像。ECS 上推荐用 docker load 导入的本地镜像，标签与代码版本一一对应，
# 不要去赌 ghcr 的语义标签（1.3.0 之类无法证明等于某个 vNN）。
FT_IMAGE=family-tree:vNNN-local

# 不填 FT_IMAGE 时才会走 ghcr + IMAGE_TAG；本地部署请把上面那行取消注释
# IMAGE_TAG=latest

# ========== 端口 ==========
# 应用端口只绑 127.0.0.1，对外由宿主机 nginx 反代，不要改成 0.0.0.0
APP_PORT=8090
MYSQL_PORT=3308
REDIS_PORT=6381

# ========== 数据库 ==========
MYSQL_DATABASE=family_tree
DB_USERNAME=family_tree_app

# MySQL root 口令：首次启动初始化时生效，之后改这里不会同步到已存在的库
MYSQL_ROOT_PASSWORD=change_me_root
# 应用账号口令
DB_PASSWORD=change_me_app

# ========== 应用 ==========
# 数据库形态：compose 里写的是 ${SPRING_PROFILES_ACTIVE:-mysql,ecs}，所以默认就是 mysql 不用填；
# 要留一份 H2 备用形态（内存更紧、或不想起 mysql 容器的机器）就显式取消注释改成 h2,ecs。
#   mysql,ecs → 数据源见 application-mysql.yml，Flyway 走 db/migration/mysql
#   h2,ecs    → 数据源见 application-h2.yml，Flyway 走 db/migration/h2，库文件在 ./data/h2
# 两条限制：
#   1) redis 不能省 —— 会话外置（spring-boot-starter-session-data-redis）与登录锁定计数都在 Redis 上，
#      H2 只省掉 mysql 容器那 512m 配额 / 实测 149Mi。
#   2) 切过去是空库 —— H2 与 MySQL 之间没有数据搬运路径，h2 那 40 条迁移会从零建出一套 schema。
# SPRING_PROFILES_ACTIVE=h2,ecs
# H2 形态才用到，默认 /app/data/h2/family_tree（对应上面的 ./data/h2 挂载），一般不用改
# H2_DATA_PATH=/app/data/h2/family_tree
# 平台管理员白名单，逗号分隔的登录用户名；留空则 /api/admin 全部拒绝
PLATFORM_ADMIN_USERNAMES=admin
FAMILY_TREE_PHOTO_DIR=/app/data/photos

# ========== 内存上限（配额按 ecs.e-c1m1.large / 1870MiB 调出，别照抄根目录的默认值）==========
# 三者之和 + OS 常驻约 330MiB 必须小于宿主总内存。当年 1870MiB 上根 compose 的 1536+1024+128 会直接 OOM。
# 实测稳态占用：app 353Mi / mysql 167Mi / redis 10Mi，宿主 used 约 1.0G，swap 基本不动。
# 2026-11-22 实例变配为 ecs.e-c1m2.large（3563MiB）后这几个值没动；JVM 按 MaxRAMPercentage=75 跟着
# APP_MEM_LIMIT 走，所以上限调大就等于堆调大 —— 重启后实测 app 362Mi / mysql 149Mi / redis 17Mi、used 1.3G。
APP_MEM_LIMIT=768m
MYSQL_MEM_LIMIT=512m
REDIS_MEM_LIMIT=96m

# ========== 阿里云短信认证服务（Dypnsapi 验证码）==========
# 对应 application.yml 的 aliyun.sms.*，由 deploy/ecs/docker-compose.yml 透传进 app 容器。
# 全部留空或 ENABLED=false 时走 LoggingSmsGateway：验证码只写 INFO 日志，真人收不到短信，
# 现有口令登录/注册流程完全不受影响 —— 所以「不配」是安全的默认态。
# 另有两个开关在**平台管理页**（落 platform_setting 表，不在这里）：
#   SMS_VERIFY_ENABLED 注册短信验证码、SMS_LOGIN_ENABLED 短信验证码登录，默认都是关闭。
#   顺序：先配好下面 5 项并重启 app → 再开平台开关，否则用户收不到码、注册会被卡住。
# Secret 只填在实例上的 /opt/family-tree/.env（0600）：不要提交、不要贴进对话、
# 不要用 echo 'AK_SECRET=xxx' 这类会落进 shell 历史的方式写。
ALIYUN_SMS_ENABLED=false
# 建议单开一对只挂 AliyunDypnsapiFullAccess 的 RAM 子账号 AK（不要用主账号 AK）
ALIYUN_SMS_ACCESS_KEY_ID=
# 交互式写入，见 deploy/ecs/RELEASE-SOP.md 的短信凭据一节
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 短信认证服务的赠送签名（不是短信服务的自定义签名）
ALIYUN_SMS_SIGN_NAME=恒创联众
# 赠送模板：100001 登录/注册验证码
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
