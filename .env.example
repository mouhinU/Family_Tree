# ==========================================
# 族谱管理系统 Docker 部署环境变量
# 复制本文件为 .env 并填写实际值
# ==========================================

# 应用端口
APP_PORT=8090

# Spring Profile: dev（H2）或 mysql（MySQL）
SPRING_PROFILES_ACTIVE=dev

# ========== MySQL 模式专用（SPRING_PROFILES_ACTIVE=mysql 时使用） ==========

# MySQL root 密码（首次启动时初始化，后续修改无效）
MYSQL_ROOT_PASSWORD=your_root_password_here

# MySQL 数据库名
MYSQL_DATABASE=family_tree

# MySQL 应用账号（由 docker-compose 自动创建）
DB_USERNAME=family_tree_app

# MySQL 应用账号密码
DB_PASSWORD=your_app_password_here

# MySQL 宿主机映射端口（可选，用于外部工具连接调试）
MYSQL_PORT=3306
