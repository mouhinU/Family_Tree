# ==========================================
# 族谱管理系统 Docker 部署环境变量
# 复制本文件为 .env 并填写实际值
# ==========================================

# 应用镜像版本（锁定版本如 1.0.0，不填则使用 latest）
IMAGE_TAG=latest

# 本地构建镜像部署时覆盖镜像（如 family-tree:v66-local），不填则用 ghcr 公共镜像
# FT_IMAGE=family-tree:vNN-local

# 应用端口
APP_PORT=8090

# Spring Profile: prod（MySQL）或 dev（H2）
SPRING_PROFILES_ACTIVE=prod

# ========== 应用数据 ==========

# 家族相册根目录：必须是容器内路径且落在 family-tree-data 卷挂载点内（默认 /app/data/photos）
FAMILY_TREE_PHOTO_DIR=/app/data/photos

# ========== MySQL 模式专用（SPRING_PROFILES_ACTIVE=mysql 时使用） ==========

# MySQL root 密码（首次启动时初始化，后续修改无效）
MYSQL_ROOT_PASSWORD=your_root_password_here

# MySQL 数据库名
MYSQL_DATABASE=family_tree

# MySQL 应用账号（由 docker-compose 自动创建）
DB_USERNAME=family_tree_app

# MySQL 应用账号密码
DB_PASSWORD=your_app_password_here

# MySQL 宿主机映射端口（仅绑定 127.0.0.1，用于外部工具连接调试）
MYSQL_PORT=3308

# Redis 宿主机映射端口（仅绑定 127.0.0.1，应用容器内走服务名 redis:6379）
REDIS_PORT=6381

# 容器内存上限（8GB 小宿主建议保留默认，防 Docker VM 内存回收误杀）
# APP_MEM_LIMIT=1536m
# MYSQL_MEM_LIMIT=1024m
# REDIS_MEM_LIMIT=128m

# ========== 监控（--profile monitoring 激活） ==========

# Prometheus 端口
PROMETHEUS_PORT=9090

# Grafana 端口
GRAFANA_PORT=3000

# Grafana 管理员密码
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here
